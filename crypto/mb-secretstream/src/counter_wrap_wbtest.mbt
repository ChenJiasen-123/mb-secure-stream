test "libsodium automatic rekey at 32-bit counter wrap" {
  let key = fixture_hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
  let header = fixture_hex("000102030405060708090a0b0c0d0e0f1011121314151617")
  let writer = init_pull(key, header).unwrap()
  let reader = init_pull(key, header).unwrap()
  for i in 0..<4 {
    writer.nonce[i] = if i == 0 { 254U } else { 255U }
    reader.nonce[i] = writer.nonce[i]
  }
  {
    let message = fixture_hex("")
    let aad = fixture_hex("")
    let frame = fixture_hex("f9ecddc933c9b46fde913a89d1985ad4e9")
    let expected_key = fixture_hex("51e3ff45a895675c4b33b46c64f4a9ace110d34df6a2ceab486372bacbd3eff6")
    let expected_nonce = fixture_hex("fffffffffcccdb20dda179c9")
    let old_key = reader.key.copy()
    let old_nonce = reader.nonce.copy()
    let damaged = frame.copy()
    damaged[damaged.length() - 1] = damaged[damaged.length() - 1] ^ 1U
    assert_true(reader.pull(damaged, aad) is Err(_))
    assert_eq(reader.key, old_key)
    assert_eq(reader.nonce, old_nonce)
    assert_eq(push(writer, message, aad, 0U).unwrap(), frame)
    assert_eq(reader.pull(frame, aad).unwrap(), (message, 0U))
    assert_eq(writer.key, expected_key)
    assert_eq(reader.key, expected_key)
    assert_eq(writer.nonce, expected_nonce)
    assert_eq(reader.nonce, expected_nonce)
  }
